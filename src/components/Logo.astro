---
// Leaf mark + wordmark set in Montserrat, matching the logo artwork.
interface Props {
  tone?: 'dark' | 'light';
  /** Below the fold (footer): load the mark lazily. */
  lazy?: boolean;
}
const { tone = 'dark', lazy = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<span class:list={['logo', `tone-${tone}`]}>
  {tone === 'light' ? (
    <img src={`${base}brand/leaf-light.png`} alt="" width="40" height="31" loading={lazy ? 'lazy' : undefined} />
  ) : (
    <>
      <img class="on-light" src={`${base}brand/leaf.png`} alt="" width="40" height="31" />
      <img class="on-dark" src={`${base}brand/leaf-light.png`} alt="" width="40" height="31" loading="lazy" />
    </>
  )}
  <span class="words">
    <span class="tru">TRUTECH</span>
    <span class="biz">BUSINESS</span>
  </span>
</span>
<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  img {
    width: 40px;
    height: auto;
  }
  .words {
    display: grid;
    line-height: 1;
    font-family: var(--font-body);
  }
  .tru {
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.06em;
  }
  .biz {
    font-weight: 500;
    font-size: 0.62rem;
    letter-spacing: 0.32em;
    color: var(--accent);
    margin-top: 3px;
  }
  .tone-light .tru {
    color: var(--white);
  }
  .tone-light .biz,
  :global([data-theme='dark']) .tone-dark .biz {
    color: var(--blue-200);
  }
  .on-dark,
  :global([data-theme='dark']) .on-light {
    display: none;
  }
  :global([data-theme='dark']) .on-dark {
    display: block;
  }
</style>
