---
// Page title area. eyebrow, title and lead are Site text keys; leadText
// replaces the lead with ready-made text (such as a date).
import Text from './Text.astro';
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  leadText?: string;
}
const { eyebrow, title, lead, leadText } = Astro.props;
---
<section class="page-hero">
  <span class="watermark" aria-hidden="true">TRUTECH</span>
  <div class="container inner">
    <Text as="p" class="eyebrow" k={eyebrow} />
    <Text as="h1" k={title} />
    {leadText ? <p class="lead">{leadText}</p> : lead && <Text as="p" class="lead" k={lead} />}
    <slot />
  </div>
</section>
<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(56px, 9vw, 104px) clamp(48px, 7vw, 80px);
    border-bottom: 1px solid var(--border);
  }
  /* Outlined brand word behind the title, as in the home hero. */
  .watermark {
    position: absolute;
    right: -2vw;
    bottom: -0.18em;
    font: 700 clamp(6rem, 18vw, 15rem) / 1 var(--font-display);
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--border);
    pointer-events: none;
    user-select: none;
  }
  .inner {
    position: relative;
  }
  h1 {
    max-width: 16ch;
  }
  .lead {
    margin-bottom: 0;
  }
</style>
