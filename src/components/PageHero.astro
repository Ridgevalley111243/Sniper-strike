---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---
<section class="page-hero">
  <span class="watermark" aria-hidden="true">TRUTECH</span>
  <div class="container inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(56px, 9vw, 104px) clamp(48px, 7vw, 80px);
    border-bottom: 1px solid var(--border);
  }
  /* Outlined brand word behind the title, as in the home hero. */
  .watermark {
    position: absolute;
    right: -2vw;
    bottom: -0.18em;
    font: 700 clamp(6rem, 18vw, 15rem) / 1 var(--font-display);
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--border);
    pointer-events: none;
    user-select: none;
  }
  .inner {
    position: relative;
  }
  h1 {
    max-width: 16ch;
  }
  .lead {
    margin-bottom: 0;
  }
</style>
