---
import FlowBackground from './FlowBackground.astro';
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---
<section class="page-hero">
  <FlowBackground tone="light" />
  <div class="container inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    color: var(--text);
    padding-block: clamp(64px, 10vw, 120px) clamp(56px, 8vw, 96px);
  }
  .inner {
    position: relative;
    z-index: 1;
  }
  .eyebrow {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(2.6rem, 6vw, 4.8rem);
    max-width: 16ch;
  }
  .lead {
    color: var(--text-muted);
  }
</style>
