---
// Project artwork: the project's own image, or a branded cover generated
// from the palette until a real image is added.
interface Props {
  title: string;
  category: string;
  cover?: string;
  seed?: number;
}
const { title, category, cover, seed = 0 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const palettes = [
  ['#0a1931', '#1a3d63', '#4a7fa7'],
  ['#1a3d63', '#4a7fa7', '#b3cfe5'],
  ['#0a1931', '#4a7fa7', '#b3cfe5'],
  ['#132a4a', '#1a3d63', '#7ea6c7'],
];
const [a, b, c] = palettes[seed % palettes.length];
const angle = 120 + ((seed * 47) % 120);
---
<div class="cover" style={`--a:${a};--b:${b};--c:${c};--angle:${angle}deg`}>
  {
    cover ? (
      <img src={base + cover} alt={`${title} preview`} loading="lazy" decoding="async" class:list={{ contain: cover.startsWith('brand/') }} />
    ) : (
      <div class="art" aria-hidden="true">
        <img src={`${base}brand/leaf-light.png`} alt="" class="mark" loading="lazy" />
        <span class="label">{category}</span>
      </div>
    )
  }
</div>
<style>
  .cover {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    background:
      radial-gradient(120% 80% at 15% 110%, var(--c) 0%, transparent 55%),
      radial-gradient(90% 70% at 100% 0%, var(--b) 0%, transparent 60%),
      linear-gradient(var(--angle), var(--a), var(--b));
    isolation: isolate;
  }
  .cover > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .cover > img.contain {
    object-fit: contain;
    padding: 12%;
  }
  .art {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .art::before {
    content: '';
    position: absolute;
    inset: -20%;
    background: repeating-radial-gradient(circle at 70% 120%, rgb(255 255 255 / 0.07) 0 2px, transparent 2px 34px);
  }
  .mark {
    width: 30%;
    opacity: 0.9;
    transition: transform 0.6s var(--ease);
  }
  .label {
    position: absolute;
    left: 18px;
    bottom: 16px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(246 250 253 / 0.85);
  }
</style>
