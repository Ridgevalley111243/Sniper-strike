---
// Slow, flowing navy-to-mist shapes inspired by the brand palette artwork.
// CSS only (no JS), paused entirely for visitors who prefer reduced motion.
---
<div class="flow" aria-hidden="true">
  <span class="blob b1"></span>
  <span class="blob b2"></span>
  <span class="blob b3"></span>
  <span class="blob b4"></span>
  <svg class="lines" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice">
    {
      Array.from({ length: 14 }, (_, i) => (
        <path
          d={`M-100 ${160 + i * 38} C 250 ${40 + i * 44}, 520 ${420 + i * 18}, 820 ${210 + i * 36} S 1180 ${120 + i * 40}, 1320 ${260 + i * 30}`}
          style={`--d:${i * -1.3}s`}
        />
      ))
    }
  </svg>
  <span class="grain"></span>
</div>
<style>
  .flow {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: radial-gradient(120% 90% at 80% 0%, #1a3d63 0%, #0a1931 55%, #07122a 100%);
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
    will-change: transform;
  }
  .b1 {
    width: 46vmax;
    height: 46vmax;
    left: -12vmax;
    top: -14vmax;
    background: #1a3d63;
    animation: drift1 26s ease-in-out infinite alternate;
  }
  .b2 {
    width: 38vmax;
    height: 38vmax;
    right: -10vmax;
    top: 10%;
    background: #4a7fa7;
    opacity: 0.45;
    animation: drift2 30s ease-in-out infinite alternate;
  }
  .b3 {
    width: 30vmax;
    height: 30vmax;
    left: 30%;
    bottom: -16vmax;
    background: #b3cfe5;
    opacity: 0.22;
    animation: drift3 34s ease-in-out infinite alternate;
  }
  .b4 {
    width: 22vmax;
    height: 22vmax;
    right: 22%;
    bottom: 8%;
    background: #4a7fa7;
    opacity: 0.3;
    animation: drift1 22s ease-in-out infinite alternate-reverse;
  }
  .lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.32;
  }
  .lines path {
    fill: none;
    stroke: #b3cfe5;
    stroke-width: 1;
    stroke-dasharray: 6 14;
    animation: flow 18s linear infinite;
    animation-delay: var(--d);
  }
  .grain {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, rgb(10 25 49 / 0.85));
  }
  @keyframes drift1 {
    to {
      transform: translate(8vmax, 6vmax) scale(1.12);
    }
  }
  @keyframes drift2 {
    to {
      transform: translate(-10vmax, 8vmax) scale(0.9);
    }
  }
  @keyframes drift3 {
    to {
      transform: translate(-6vmax, -8vmax) scale(1.15);
    }
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -400;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blob,
    .lines path {
      animation: none;
    }
  }
</style>
