---
import type { CollectionEntry } from 'astro:content';
import Cover from './Cover.astro';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}
const { project, index = 0 } = Astro.props;
const p = project.data;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<article class="project reveal">
  <a href={`${base}work/${project.id}/`} class="link">
    <div class="media">
      <Cover title={p.title} category={p.category} cover={p.cover} seed={index} />
      <span class:list={['status', p.status.toLowerCase().replace(/\s/g, '-')]}>{p.status}</span>
    </div>
    <div class="body">
      <p class="meta">{p.category} · {p.year}</p>
      <h3>{p.title}</h3>
      <p class="summary">{p.summary}</p>
      <span class="more">View case study <Icon name="arrow" size={18} /></span>
    </div>
  </a>
</article>
<style>
  .link {
    display: grid;
    gap: 18px;
    text-decoration: none;
    height: 100%;
  }
  .media {
    position: relative;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s var(--ease);
  }
  .link:hover .media {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .link:hover :global(.cover > img:not(.contain)),
  .link:hover :global(.mark) {
    transform: scale(1.05);
  }
  .status {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    background: rgb(246 250 253 / 0.92);
    color: var(--navy-950);
    backdrop-filter: blur(6px);
  }
  .status::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--blue-500);
    vertical-align: 1px;
  }
  .status.live::before,
  .status.completed::before {
    background: #1f8a5b;
  }
  .status.planned::before {
    background: #8a99ad;
  }
  .meta {
    margin: 0 0 6px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h3 {
    margin-bottom: 8px;
  }
  .summary {
    color: var(--text-muted);
    margin-bottom: 12px;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .more :global(svg) {
    transition: transform 0.2s var(--ease);
  }
  .link:hover .more :global(svg) {
    transform: translateX(4px);
  }
</style>
