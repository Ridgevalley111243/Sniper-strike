---
import fs from 'node:fs';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../site';
import '../styles/global.css';
import '../styles/portfolio.css';

interface Props {
  title?: string;
  description?: string;
  /** Home page: transparent header over the dark hero. */
  overDark?: boolean;
  /** Private pages (client deliveries) must never be indexed. */
  noindex?: boolean;
  bare?: boolean;
}
const { title, description = `${site.brand}: ${site.tagline} ${site.intro}`, overDark = false, noindex = false, bare = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const fullTitle = title ? `${title} · ${site.brand}` : `${site.brand}: ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}brand/og.png`, Astro.site);

// Brand display font. Drop AlRagas.woff2 (or .otf/.ttf) into public/fonts/
// and it is used everywhere; until then the close match "Gloock" is shown.
const ragas = ['woff2', 'otf', 'ttf'].find((ext) => fs.existsSync(`public/fonts/AlRagas.${ext}`));
const ragasFormat = { woff2: 'woff2', otf: 'opentype', ttf: 'truetype' }[ragas ?? 'woff2'];
---
<!doctype html>
<html lang="en" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow, noarchive" /> : <link rel="canonical" href={canonical} />}
    {noindex && <meta name="referrer" content="no-referrer" />}
    <meta name="theme-color" content="#3d0b37" />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    {
      !noindex && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:title" content={fullTitle} />
          <meta property="og:description" content={description} />
          <meta property="og:image" content={ogImage} />
          <meta property="og:url" content={canonical} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Gloock&family=Montserrat:wght@400;500;600;700&display=swap"
    />
    {
      ragas && (
        <style
          is:inline
          set:html={`@font-face{font-family:'Al Ragas';src:url('${base}fonts/AlRagas.${ragas}') format('${ragasFormat}');font-display:swap;}`}
        />
      )
    }
    <script is:inline>
      // Runs before the page paints, so there's no flash of the wrong theme.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch (e) {}
        var system = matchMedia('(prefers-color-scheme: dark)');
        root.dataset.theme = saved === 'light' || saved === 'dark' ? saved : system.matches ? 'dark' : 'light';
        if (!saved) {
          system.addEventListener('change', function (e) {
            var chosen = null;
            try {
              chosen = localStorage.getItem('theme');
            } catch (err) {}
            if (!chosen) root.dataset.theme = e.matches ? 'dark' : 'light';
          });
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {!bare && <Header overDark={overDark} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    <script>
      // Reveal sections as they scroll into view (CSS skips this under reduced motion).
      const items = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
    {
      !bare && (
        <script>
          // Hidden way into the admin: long-press (phones) or double-click
          // (computers) an empty part of any page.
          const base = document.documentElement.dataset.base ?? '/';
          const open = () => (location.href = base + 'admin/');
          const empty = (t: EventTarget | null) =>
            t instanceof Element &&
            !t.closest('a, button, input, textarea, select, label, summary, video, img, svg, [role="button"], [contenteditable]');
          document.addEventListener('dblclick', (e) => {
            if (empty(e.target) && !getSelection()?.toString().trim()) open();
          });
          let timer: number | undefined;
          let x = 0;
          let y = 0;
          const cancel = () => clearTimeout(timer);
          document.addEventListener(
            'touchstart',
            (e) => {
              cancel();
              if (e.touches.length !== 1 || !empty(e.target)) return;
              ({ clientX: x, clientY: y } = e.touches[0]);
              timer = window.setTimeout(open, 1200);
            },
            { passive: true },
          );
          document.addEventListener(
            'touchmove',
            (e) => {
              const t = e.touches[0];
              if (Math.hypot(t.clientX - x, t.clientY - y) > 12) cancel();
            },
            { passive: true },
          );
          ['touchend', 'touchcancel', 'scroll'].forEach((t) => document.addEventListener(t, cancel, { passive: true }));
        </script>
      )
    }
  </body>
</html>
