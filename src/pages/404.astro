---
import PageHero from '../components/PageHero.astro';
import Base from '../layouts/Base.astro';
import Text from '../components/Text.astro';
import { projectLabels, t } from '../lib/t';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title={t('404.title')} noindex>
  <div data-missing>
    <PageHero eyebrow="404.eyebrow" title="404.title" lead="404.lead">
      <a class="btn btn-primary" href={base}><Text k="404.button" /></a>
    </PageHero>
  </div>
  <div data-project data-labels={JSON.stringify(projectLabels())} hidden></div>
</Base>
<script>
  // A project added in the admin since the last deploy has no page yet:
  // GitHub Pages serves this 404 page, which draws the project itself.
  import { liveProject } from '../scripts/live';
  const base = document.documentElement.dataset.base ?? '/';
  const slug = location.pathname.startsWith(base) && location.pathname.slice(base.length).match(/^work\/([a-z0-9-]+)\/?$/)?.[1];
  if (slug) {
    const missing = document.querySelector<HTMLElement>('[data-missing]')!;
    const el = document.querySelector<HTMLElement>('[data-project]')!;
    missing.hidden = true;
    el.hidden = false;
    el.setAttribute('aria-busy', 'true');
    el.innerHTML = `<section class="container pd-head"><p class="sr-only" role="status">Loading project…</p><div aria-hidden="true">
      <span class="skel skel-line" style="width:90px"></span><span class="skel skel-line" style="width:160px"></span>
      <span class="skel skel-title" style="height:3em;width:min(100%,640px)"></span>
      <span class="skel skel-line" style="width:min(100%,560px)"></span><span class="skel skel-line" style="width:min(80%,420px)"></span>
      <span class="skel" style="aspect-ratio:21/9;border-radius:28px;margin-top:40px"></span></div></section>`;
    liveProject(el, slug)
      .then(() => el.removeAttribute('aria-busy'))
      .catch(() => {
      el.hidden = true;
      missing.hidden = false;
    });
  }
</script>
