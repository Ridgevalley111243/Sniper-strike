---
import PageHero from '../components/PageHero.astro';
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Page not found" overDark noindex>
  <PageHero eyebrow="404" title="This page didn’t grow here." lead="The link may be old or mistyped.">
    <a class="btn btn-light" href={base}>Back to home</a>
  </PageHero>
</Base>
