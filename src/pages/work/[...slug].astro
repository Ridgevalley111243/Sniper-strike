---
import { getCollection, render } from 'astro:content';
import Cover from '../../components/Cover.astro';
import Icon from '../../components/Icon.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, index: i, next: projects[(i + 1) % projects.length], nextIndex: (i + 1) % projects.length },
  }));
}
const { project, index, next, nextIndex } = Astro.props;
const p = project.data;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title={p.title} description={p.summary}>
  <article>
    <header class="container head">
      <a class="back" href={base + 'work/'}><Icon name="arrow" size={18} /> All work</a>
      <p class="eyebrow">{p.category}</p>
      <h1>{p.title}</h1>
      <p class="lead">{p.summary}</p>
      <dl class="facts">
        <div><dt>Client</dt><dd>{p.client}</dd></div>
        <div><dt>Year</dt><dd>{p.year}</dd></div>
        <div><dt>Status</dt><dd>{p.status}</dd></div>
        {p.link && <div><dt>Link</dt><dd><a href={p.link} target="_blank" rel="noopener">Visit site <Icon name="arrow-up-right" size={16} /></a></dd></div>}
      </dl>
    </header>
    <div class="container media">
      <Cover title={p.title} category={p.category} cover={p.cover} seed={index} />
    </div>
    <div class="container body">
      <aside>
        <h2 class="h">Services</h2>
        <ul class="tags">{p.services.map((s) => <li class="tag">{s}</li>)}</ul>
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>
    {
      p.gallery.length > 0 && (
        <div class="container gallery">
          {p.gallery.map((g) => (
            <img src={base + g.src} alt={g.alt} loading="lazy" decoding="async" />
          ))}
        </div>
      )
    }
  </article>
  {
    next.id !== project.id && (
      <section class="section next">
        <div class="container">
          <p class="eyebrow">Next project</p>
          <div class="next-card">
            <ProjectCard project={next} index={nextIndex} />
          </div>
        </div>
      </section>
    )
  }
</Base>
<style>
  .head {
    padding-top: clamp(40px, 6vw, 72px);
  }
  .back {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-bottom: 24px;
    font-weight: 600;
    text-decoration: none;
    color: var(--accent);
  }
  .back :global(svg) {
    transform: rotate(180deg);
  }
  h1 {
    font-size: clamp(2.4rem, 5.6vw, 4.6rem);
    max-width: 18ch;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin: 36px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  dd {
    margin: 4px 0 0;
    font-weight: 600;
  }
  dd a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .media {
    margin-block: clamp(36px, 5vw, 56px);
  }
  .media :global(.cover) {
    aspect-ratio: 21 / 9;
    border-radius: var(--radius-lg);
  }
  @media (max-width: 640px) {
    .media :global(.cover) {
      aspect-ratio: 4 / 3;
    }
  }
  .body {
    display: grid;
    gap: 40px;
    padding-bottom: clamp(56px, 8vw, 96px);
  }
  @media (min-width: 900px) {
    .body {
      grid-template-columns: 260px 1fr;
      gap: 72px;
    }
    aside {
      position: sticky;
      top: 100px;
      align-self: start;
    }
  }
  .h {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 14px;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(li) {
    margin-bottom: 0.4em;
  }
  /* Masonry columns, so flyers of different shapes keep their proportions. */
  .gallery {
    columns: 1;
    column-gap: 20px;
    padding-bottom: 80px;
  }
  @media (min-width: 640px) {
    .gallery {
      columns: 2;
    }
  }
  @media (min-width: 1024px) {
    .gallery {
      columns: 3;
    }
  }
  .gallery img {
    width: 100%;
    margin-bottom: 20px;
    break-inside: avoid;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .next {
    background: var(--surface-2);
  }
  .next-card {
    max-width: 560px;
  }
</style>
