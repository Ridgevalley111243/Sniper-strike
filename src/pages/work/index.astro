---
import PageHero from '../../components/PageHero.astro';
import Base from '../../layouts/Base.astro';
import { projects } from '../../lib/build-data';
import { fingerprint, groupOf } from '../../lib/content';
import { filtersHTML, workGridHTML } from '../../lib/render';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const groups = [...new Set(projects.map(groupOf))];
---
<Base title="Work" description="Selected projects by Trutech Business: websites, management systems, digital commerce, graphic design and branding.">
  <PageHero
    eyebrow="Portfolio"
    title="Work built for real needs."
    lead="Websites, management systems, digital commerce and graphic design, each with an honest note on where it stands."
  />
  <section class="section">
    <div class="container">
      <h2 class="sr-only">Projects</h2>
      <div class="filters" role="group" aria-label="Filter projects" data-filters set:html={filtersHTML(groups)} />
      <div class="grid grid-3" data-grid data-fp={fingerprint(projects)} set:html={workGridHTML(projects, base, groupOf)} />
    </div>
  </section>
</Base>
<script>
  import { bindFilters, liveWork } from '../../scripts/live';
  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const filters = document.querySelector<HTMLElement>('[data-filters]')!;
  bindFilters(grid, filters);
  liveWork(grid, filters).catch(() => {});
</script>
<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 40px;
  }
  .filters :global(button) {
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1.5px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font: 600 0.9rem var(--font-body);
    cursor: pointer;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s;
  }
  .filters :global(button:hover) {
    border-color: var(--blue-500);
  }
  .filters :global(button[aria-pressed='true']) {
    background: var(--inverse-bg);
    border-color: var(--inverse-bg);
    color: var(--inverse-text);
  }
</style>
