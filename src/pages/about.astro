---
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import Base from '../layouts/Base.astro';
import { site } from '../site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const logo = `${base}brand/logo-on-dark.png`;
const photoAlt = `Photo of ${site.owner || 'the founder of Trutech Business'}`;
---
<Base title="About" description={site.about.paragraphs[0]}>
  <PageHero eyebrow="About" title={site.owner ? `Hi, I’m ${site.owner}.` : 'The person behind Trutech Business.'} lead={site.role} />
  <section class="section">
    <div class="container story">
      <div class:list={['portrait reveal', { 'has-photo': site.photo }]} data-photo-slot data-photo={site.photo} data-fallback={logo}>
        <img src={site.photo || logo} alt={site.photo ? photoAlt : ''} />
      </div>
      <div class="reveal">
        {site.about.paragraphs.map((p) => <p class="text">{p}</p>)}
        <p class="quote display">“{site.tagline}”</p>
      </div>
    </div>
  </section>

  <section class="section tint">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Five roles, one direction</p>
          <h2>Designing, building and supporting digital solutions.</h2>
        </div>
      </div>
      <div class="grid grid-3">
        {
          site.about.roles.map((r) => (
            <article class="card reveal">
              <h3>{r.title}</h3>
              <p class="muted">{r.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Toolkit</p>
          <h2>Tools I build with.</h2>
          <p class="muted">Used, explored or in progress; I keep learning as the work demands.</p>
        </div>
      </div>
      <div class="grid grid-3">
        {
          site.about.toolkit.map((t) => (
            <div class="card reveal">
              <h3 class="area">{t.area}</h3>
              <ul class="tags">{t.tools.map((x) => <li class="tag">{x}</li>)}</ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section mindset">
    <div class="container narrow reveal">
      <p class="eyebrow">How I think</p>
      <h2>I start from the real need.</h2>
      <p class="lead">Before writing code I ask: what problem does it solve? What should it look like? How will people sign in? Where is the data stored? How will payments work? How will it be run, deployed and maintained?</p>
      <a class="btn btn-primary" href={base + 'contact/'}>Work with me <Icon name="arrow" /></a>
    </div>
  </section>
</Base>
<script>
  import { liveProfilePhoto } from '../scripts/profile';
  liveProfilePhoto().catch(() => {});
</script>
<style>
  .story {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .story {
      grid-template-columns: 0.9fr 1.3fr;
      gap: 80px;
    }
  }
  .portrait {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    display: grid;
    place-items: center;
    background:
      radial-gradient(100% 70% at 20% 100%, rgb(255 221 0 / 0.35), transparent 60%),
      linear-gradient(160deg, var(--purple-900), var(--purple-700));
    box-shadow: var(--shadow-lg);
  }
  .portrait {
    overflow: hidden;
  }
  .portrait img {
    width: 62%;
  }
  .portrait.has-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .text {
    font-size: 1.08rem;
  }
  .quote {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    color: var(--accent);
    margin-top: 32px;
  }
  .area {
    font-size: 1.4rem;
    margin-bottom: 16px;
  }
  .mindset {
    background: var(--surface-2);
  }
  .narrow {
    max-width: 820px;
  }
  .narrow .lead {
    margin-bottom: 32px;
  }
</style>
