---
import PageHero from '../components/PageHero.astro';
import Base from '../layouts/Base.astro';
import { markdown } from '../lib/render';
import { t, tf } from '../lib/t';
---
<Base title={t('privacy.title')} description={t('privacy.title')}>
  <PageHero eyebrow="legal.eyebrow" title="privacy.title" leadText={tf('legal.updated', { date: t('privacy.updated') })} />
  <section class="section">
    <div class="container prose legal-text" set:html={markdown(tf('privacy.body'))} />
  </section>
</Base>
<style>
  .legal-text {
    max-width: 72ch;
  }
  .legal-text :global(h2) {
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
    margin-top: 1.8em;
  }
  .legal-text :global(li) {
    margin-bottom: 0.5em;
  }
</style>
