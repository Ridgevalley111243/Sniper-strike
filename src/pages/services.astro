---
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import Base from '../layouts/Base.astro';
import { site } from '../site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Services" overDark description="Websites and web apps, management systems, digital commerce, branding, multimedia, IT support and ICT training from Trutech Business.">
  <PageHero
    eyebrow="Services"
    title="Everything you need to go digital."
    lead="From your brand and website to the systems that run your business, built and supported by one person who understands the whole picture."
  />
  <section class="section">
    <div class="container list">
      {
        site.services.map((s, i) => (
          <article class="row reveal">
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <div class="title">
              <span class="icon"><Icon name={s.icon} /></span>
              <h2>{s.title}</h2>
            </div>
            <div>
              <p class="lead">{s.text}</p>
              <ul class="tags">{s.points.map((pt) => <li class="tag">{pt}</li>)}</ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>
  <section class="section dark">
    <div class="container center reveal">
      <h2>Not sure what you need?</h2>
      <p class="lead">Describe the problem and I’ll suggest the simplest thing that solves it.</p>
      <a class="btn btn-light" href={base + 'contact/'}>Talk to me <Icon name="arrow" /></a>
    </div>
  </section>
</Base>
<style>
  .list {
    display: grid;
  }
  .row {
    display: grid;
    gap: 16px 40px;
    padding-block: clamp(28px, 4vw, 44px);
    border-top: 1px solid var(--border);
  }
  .row:last-child {
    border-bottom: 1px solid var(--border);
  }
  @media (min-width: 900px) {
    .row {
      grid-template-columns: 60px 1fr 1.3fr;
      align-items: start;
    }
  }
  .n {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--blue-500);
  }
  .title {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .title h2 {
    font-size: clamp(1.6rem, 2.8vw, 2.3rem);
    margin: 0;
  }
  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--navy-950), var(--navy-800));
    color: var(--blue-200);
  }
  .lead {
    margin-bottom: 16px;
  }
  .center {
    text-align: center;
  }
  .center .lead {
    margin: 0 auto 28px;
  }
</style>
