---
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import Text from '../components/Text.astro';
import Base from '../layouts/Base.astro';
import { t } from '../lib/t';
import { site } from '../site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title={t('servicesPage.eyebrow')} description={t('servicesPage.lead')}>
  <PageHero eyebrow="servicesPage.eyebrow" title="servicesPage.title" lead="servicesPage.lead" />
  <section class="section">
    <div class="container list">
      {
        site.services.map((s, i) => (
          <article class="row reveal">
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <div class="title">
              <span class="icon"><Icon name={s.icon} /></span>
              <Text as="h2" k={`service.${i + 1}.title`} />
            </div>
            <div>
              <Text as="p" class="lead" k={`service.${i + 1}.text`} />
              <ul class="tags">{s.points.map((pt) => <li class="tag">{pt}</li>)}</ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>
  <section class="section dark">
    <div class="container center reveal">
      <Text as="h2" k="servicesPage.askTitle" />
      <Text as="p" class="lead" k="servicesPage.askText" />
      <a class="btn btn-light" href={base + 'contact/'}><Text k="servicesPage.askButton" /> <Icon name="arrow" /></a>
    </div>
  </section>
</Base>
<style>
  .list {
    display: grid;
  }
  .row {
    display: grid;
    gap: 16px 40px;
    padding-block: clamp(28px, 4vw, 44px);
    border-top: 1px solid var(--border);
  }
  .row:last-child {
    border-bottom: 1px solid var(--border);
  }
  @media (min-width: 900px) {
    .row {
      grid-template-columns: 60px 1fr 1.3fr;
      align-items: start;
    }
  }
  .n {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--accent);
  }
  .title {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .title h2 {
    font-size: clamp(1.6rem, 2.8vw, 2.3rem);
    margin: 0;
  }
  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--amber);
    color: var(--ink);
  }
  .lead {
    margin-bottom: 16px;
  }
  .center {
    text-align: center;
  }
  .center .lead {
    margin: 0 auto 28px;
  }
</style>
