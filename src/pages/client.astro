---
// Client work. Each client gets a private link like /client/#<token>, created
// in the admin (Client work). The page asks the client-portal edge function for
// the files and shows them; the client can approve, ask for changes or leave a
// review, which is saved and then sent to the owner on WhatsApp.
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Your project" noindex bare>
  <div class="shell">
    <header class="top">
      <div class="container bar">
        <a href={base} aria-label="Trutech Business home"><Logo tone="light" /></a>
        <span class="secure"><Icon name="lock" size={16} /> Private link</span>
      </div>
    </header>

    <section class="container delivery" data-state="loading" aria-busy="true">
      <p class="sr-only" role="status">Opening your project…</p>
      <div aria-hidden="true">
        <span class="skel skel-line" style="width: 120px"></span>
        <span class="skel skel-title"></span>
        <span class="skel skel-pill"></span>
        <span class="skel skel-line" style="width: 85%; margin-top: 24px"></span>
        <span class="skel skel-line" style="width: 60%"></span>
        <div class="files skel-files">
          {[0, 1, 2].map(() => (
            <div class="file card">
              <span class="skel skel-block"></span>
              <span class="skel skel-line" style="width: 70%"></span>
              <span class="skel skel-line" style="width: 40%"></span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="container state" data-state="error" hidden>
      <h1>We couldn’t open this link.</h1>
      <p class="lead" data-error>Check that you used the complete link you were sent.</p>
      <a class="btn btn-primary" href={base + 'contact/'}>Contact Trutech Business</a>
    </section>

    <div class="container delivery" data-state="ready" hidden>
      <p class="eyebrow" data-field="client"></p>
      <h1 data-field="title"></h1>
      <div class="meta">
        <span class="badge" data-field="status"></span>
        <span class="muted" data-field="date"></span>
      </div>
      <p class="lead message" data-field="message"></p>

      <h2 class="h2">Files</h2>
      <div class="files" data-files></div>

      <section class="card review" data-review aria-labelledby="review-title">
        <h2 id="review-title" data-review-title>Your feedback</h2>
        <p class="muted" data-review-intro></p>
        <form data-form novalidate>
          <div class="field">
            <label for="r-name">Your name</label>
            <input id="r-name" name="name" autocomplete="name" maxlength="120" required />
          </div>
          <fieldset class="field choices" data-decisions>
            <legend>Your decision</legend>
            <label class="choice"><input type="radio" name="decision" value="approve" checked /> <span><strong>Approve</strong> It’s ready</span></label>
            <label class="choice"><input type="radio" name="decision" value="changes" /> <span><strong>Request changes</strong> Tell me what to change</span></label>
          </fieldset>
          <fieldset class="field stars" data-rating hidden>
            <legend>Your rating</legend>
            <div class="star-row">
              {[5, 4, 3, 2, 1].map((n) => (
                <label class="star">
                  <input type="radio" name="rating" value={n} checked={n === 5} />
                  <span aria-hidden="true">★</span>
                  <span class="sr-only">{n} out of 5</span>
                </label>
              ))}
            </div>
          </fieldset>
          <div class="field">
            <label for="r-comment" data-comment-label>Comments</label>
            <textarea id="r-comment" name="comment" rows="5" maxlength="4000" placeholder="What do you like, and what should change?"></textarea>
          </div>
          <p class="error" role="alert" data-form-error hidden></p>
          <button class="btn btn-primary" type="submit" data-submit><Icon name="whatsapp" /> <span>Send feedback</span></button>
          <p class="hint muted">Your feedback is saved and opens in WhatsApp, ready to send to Trutech Business. By sending it you agree to our <a href={base + 'terms/'}>Terms</a> and <a href={base + 'privacy/'}>Privacy Policy</a>.</p>
        </form>
        <div class="thanks" data-thanks hidden>
          <h3>Thank you! Your feedback is saved.</h3>
          <p class="muted">If WhatsApp didn’t open, tap below to send it.</p>
          <a class="btn btn-primary" data-wa target="_blank" rel="noopener"><Icon name="whatsapp" /> Send on WhatsApp</a>
        </div>
      </section>

      <section class="history" data-history hidden>
        <h2 class="h2">Earlier feedback</h2>
        <ul data-history-list></ul>
      </section>

      <p class="foot muted">
        These files were prepared for you by Trutech Business. Please don’t share this link: anyone with it can view them.
        <a href={base + 'terms/'}>Terms</a> · <a href={base + 'privacy/'}>Privacy</a>
      </p>
    </div>
  </div>
</Base>

<script>
  import { CLIENT_PORTAL_URL, SUPABASE_ANON_KEY } from '../lib/content';
  import { esc } from '../lib/render';

  type FileItem = { id: string; name: string; size: number; mime: string; url: string | null; download: string | null };
  type Review = { reviewer_name: string; decision: string; rating: number | null; comment: string; created_at: string };
  type Delivery = {
    client_name: string;
    title: string;
    message: string;
    kind: 'review' | 'delivery';
    status: string;
    allow_download: boolean;
    created_at: string;
    files: FileItem[];
    reviews: Review[];
    whatsapp: string;
  };

  const STATUS: Record<string, string> = {
    awaiting_review: 'Awaiting your review',
    changes_requested: 'Changes requested',
    approved: 'Approved',
    delivered: 'Delivered',
  };
  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const show = (state: string) =>
    document.querySelectorAll<HTMLElement>('[data-state]').forEach((el) => (el.hidden = el.dataset.state !== state));
  const fail = (message: string) => {
    $('[data-error]').textContent = message;
    show('error');
  };
  const set = (field: string, value?: string) => {
    const el = $(`[data-field="${field}"]`);
    el.textContent = value ?? '';
    el.hidden = !value;
  };
  const date = (iso: string) => new Date(iso).toLocaleDateString(undefined, { day: 'numeric', month: 'long', year: 'numeric' });
  const size = (n: number) => (n < 1024 * 1024 ? `${Math.max(1, Math.round(n / 1024))} KB` : `${(n / 1024 / 1024).toFixed(1)} MB`);
  const ext = (name: string) => (name.includes('.') ? name.split('.').pop()!.toUpperCase().slice(0, 9) : 'FILE');
  const kindOf = (f: FileItem) =>
    f.mime.startsWith('image/') && !f.mime.includes('photoshop')
      ? 'image'
      : f.mime === 'application/pdf' || f.name.toLowerCase().endsWith('.pdf')
        ? 'pdf'
        : f.mime.startsWith('video/')
          ? 'video'
          : f.mime.startsWith('audio/')
            ? 'audio'
            : 'file';

  const token = location.hash.slice(1);
  const api = (init?: RequestInit, query = '') =>
    fetch(CLIENT_PORTAL_URL + query, { ...init, headers: { apikey: SUPABASE_ANON_KEY, 'Content-Type': 'application/json', ...init?.headers } });

  function fileCard(f: FileItem, allowDownload: boolean) {
    const kind = kindOf(f);
    const url = f.url ? esc(f.url) : '';
    if (!allowDownload) return protectedCard(f, kind, url);
    const preview =
      kind === 'image' && url
        ? `<a class="preview" href="${url}" target="_blank" rel="noopener"><img src="${url}" alt="${esc(f.name)}" loading="lazy" /></a>`
        : kind === 'video' && url
          ? `<div class="preview"><video src="${url}" controls preload="metadata"></video></div>`
          : kind === 'audio' && url
            ? `<div class="preview icon">♪<audio src="${url}" controls preload="none"></audio></div>`
            : `<div class="preview icon"><span class="ext">${esc(ext(f.name))}</span></div>`;
    const actions = [
      kind === 'pdf' && url ? `<a class="btn btn-ghost" href="${url}" target="_blank" rel="noopener">View PDF</a>` : '',
      f.download ? `<a class="btn btn-primary" href="${esc(f.download)}">Download</a>` : '',
    ].join('');
    return `<article class="file card">${preview}<div class="info"><h3 class="name">${esc(f.name)}</h3><p class="muted">${esc(ext(f.name))} · ${size(f.size)}</p><div class="actions">${actions}</div></div></article>`;
  }

  // View-only files (downloads off): shown inside the page with a watermark,
  // without links to the files themselves. Websites can't block screenshots;
  // this makes copies harder to take and marks the ones that are.
  function protectedCard(f: FileItem, kind: string, url: string) {
    const wm = '<div class="wm" aria-hidden="true"></div>';
    const preview =
      kind === 'image' && url
        ? `<div class="preview guarded"><canvas data-image="${url}" role="img" aria-label="${esc(f.name)}"></canvas>${wm}</div>`
        : kind === 'video' && url
          ? `<div class="preview guarded"><video src="${url}" controls controlslist="nodownload noplaybackrate noremoteplayback" disablepictureinpicture preload="metadata"></video>${wm}</div>`
          : kind === 'audio' && url
            ? `<div class="preview icon">♪<audio src="${url}" controls controlslist="nodownload noplaybackrate" preload="none"></audio></div>`
            : kind === 'pdf' && url
              ? `<div class="preview guarded pdf" data-pdf="${url}"><span class="ext">PDF</span>${wm}</div>`
              : `<div class="preview icon"><span class="ext">${esc(ext(f.name))}</span></div>`;
    const action =
      kind === 'pdf' && url
        ? '<button class="btn btn-ghost" type="button" data-open-pdf>View PDF</button>'
        : kind === 'file'
          ? '<p class="note">View only: you’ll receive this file once the work is approved.</p>'
          : '';
    return `<article class="file card">${preview}<div class="info"><h3 class="name">${esc(f.name)}</h3><p class="muted">${esc(ext(f.name))} · ${size(f.size)} · view only</p><div class="actions">${action}</div></div></article>`;
  }

  function protect(d: Delivery) {
    const shell = $('.shell');
    shell.classList.add('protected');
    const mark = `${d.client_name} · Trutech Business · ${date(new Date().toISOString())}`;
    const tile = (color: string) =>
      `url("data:image/svg+xml,${encodeURIComponent(
        `<svg xmlns='http://www.w3.org/2000/svg' width='320' height='180'><text x='10' y='110' transform='rotate(-24 160 90)' fill='${color}' font-family='Montserrat,Arial,sans-serif' font-size='15' font-weight='600'>${mark.replace(/[<&'"]/g, '')}</text></svg>`,
      )}")`;
    shell.style.setProperty('--wm', tile('rgba(255,255,255,0.42)'));
    shell.style.setProperty('--wm-dark', tile('rgba(10,25,49,0.32)'));

    // Images are drawn on a canvas with the watermark baked in, so there's no
    // image to save, drag or open on its own.
    document.querySelectorAll<HTMLCanvasElement>('canvas[data-image]').forEach((canvas) => {
      const img = new Image();
      img.onload = () => {
        const scale = Math.min(1, 1600 / img.naturalWidth);
        canvas.width = Math.round(img.naturalWidth * scale);
        canvas.height = Math.round(img.naturalHeight * scale);
        const ctx = canvas.getContext('2d')!;
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        ctx.save();
        ctx.font = `600 ${Math.max(14, Math.round(canvas.width / 34))}px Montserrat, Arial, sans-serif`;
        ctx.fillStyle = 'rgba(255,255,255,0.45)';
        ctx.strokeStyle = 'rgba(10,25,49,0.35)';
        ctx.lineWidth = 1;
        ctx.translate(canvas.width / 2, canvas.height / 2);
        ctx.rotate(-0.42);
        const step = Math.max(120, canvas.width / 5);
        for (let y = -canvas.height; y < canvas.height; y += step) {
          for (let x = -canvas.width; x < canvas.width; x += ctx.measureText(mark).width + 60) {
            ctx.fillText(mark, x, y);
            ctx.strokeText(mark, x, y);
          }
        }
        ctx.restore();
      };
      img.src = canvas.dataset.image!;
    });

    // PDFs open inside the page, without the viewer's download toolbar.
    $('[data-files]').addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('[data-open-pdf]');
      if (!b) return;
      const box = b.closest('.file')!.querySelector<HTMLElement>('[data-pdf]')!;
      box.innerHTML = `<iframe src="${esc(box.dataset.pdf!)}#toolbar=0&navpanes=0&statusbar=0" title="PDF preview"></iframe><div class="wm" aria-hidden="true"></div>`;
      box.classList.add('expanded');
      b.remove();
    });

    const files = $('[data-files]');
    ['contextmenu', 'dragstart', 'copy'].forEach((type) => files.addEventListener(type, (e) => e.preventDefault()));
    // Blur the files whenever the page isn't in front: switching apps, opening
    // a screenshot or recording tool, or pressing Print Screen.
    const shield = (on: boolean) => shell.classList.toggle('shielded', on);
    addEventListener('blur', () => {
      if (!(document.activeElement instanceof HTMLIFrameElement)) shield(true);
    });
    addEventListener('focus', () => shield(false));
    document.addEventListener('visibilitychange', () => shield(document.hidden));
    addEventListener('keyup', (e) => {
      if (e.key !== 'PrintScreen') return;
      shield(true);
      navigator.clipboard?.writeText('').catch(() => {});
      setTimeout(() => shield(false), 1500);
    });
    addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && ['s', 'p'].includes(e.key.toLowerCase())) e.preventDefault();
    });
  }

  function history(reviews: Review[]) {
    const label = (r: Review) =>
      r.decision === 'approve' ? 'Approved' : r.decision === 'changes' ? 'Requested changes' : 'Feedback';
    $('[data-history-list]').innerHTML = reviews
      .slice()
      .reverse()
      .map(
        (r) =>
          `<li><p class="muted">${esc(date(r.created_at))} · ${esc(r.reviewer_name || 'Client')} · ${label(r)}${r.rating ? ` · ${'★'.repeat(r.rating)}` : ''}</p>${r.comment ? `<p>${esc(r.comment)}</p>` : ''}</li>`,
      )
      .join('');
    $('[data-history]').hidden = reviews.length === 0;
  }

  function whatsappText(d: Delivery, name: string, decision: string, rating: number | null, comment: string) {
    const verdict =
      decision === 'approve'
        ? d.kind === 'delivery'
          ? 'I have received the files.'
          : '✅ I approve this work.'
        : decision === 'changes'
          ? '✏️ I would like some changes.'
          : 'Here is my feedback.';
    return [
      `Hello Trutech Business, this is ${name || d.client_name}.`,
      `Project: ${d.title}`,
      verdict,
      rating ? `Rating: ${'★'.repeat(rating)} (${rating}/5)` : '',
      comment ? `\n${comment}` : '',
      `\n${location.href}`,
    ]
      .filter(Boolean)
      .join('\n');
  }

  function setupForm(d: Delivery) {
    const form = $<HTMLFormElement>('[data-form]');
    const isDelivery = d.kind === 'delivery';
    $('[data-review-title]').textContent = isDelivery ? 'Leave a review' : 'Your feedback';
    $('[data-review-intro]').textContent = isDelivery
      ? 'Let me know you have everything, and how the work went.'
      : 'Approve the work, or tell me what you’d like changed.';
    $('[data-decisions]').hidden = isDelivery;
    $('[data-rating]').hidden = !isDelivery;
    $('[data-comment-label]').textContent = isDelivery ? 'Your review (optional)' : 'Comments';
    (form.elements.namedItem('name') as HTMLInputElement).value = d.client_name;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const decision = isDelivery ? 'approve' : String(data.get('decision'));
      const rating = isDelivery ? Number(data.get('rating')) || null : null;
      const comment = String(data.get('comment') ?? '').trim();
      const error = $('[data-form-error]');
      error.hidden = true;
      if (!name) return Object.assign(error, { hidden: false, textContent: 'Please enter your name.' });
      if (decision === 'changes' && !comment)
        return Object.assign(error, { hidden: false, textContent: 'Please describe the changes you’d like.' });

      const submit = $<HTMLButtonElement>('[data-submit]');
      submit.disabled = true;
      submit.querySelector('span')!.textContent = 'Sending…';
      try {
        const res = await api({ method: 'POST', body: JSON.stringify({ t: token, name, decision, rating, comment }) });
        if (!res.ok) throw new Error(String(res.status));
        const { whatsapp } = await res.json();
        const wa = `https://wa.me/${whatsapp || d.whatsapp}?text=${encodeURIComponent(whatsappText(d, name, decision, rating, comment))}`;
        $<HTMLAnchorElement>('[data-wa]').href = wa;
        form.hidden = true;
        $('[data-thanks]').hidden = false;
        history([...d.reviews, { reviewer_name: name, decision, rating, comment, created_at: new Date().toISOString() }]);
        location.href = wa;
      } catch {
        submit.disabled = false;
        submit.querySelector('span')!.textContent = 'Send feedback';
        Object.assign(error, { hidden: false, textContent: 'Sorry, that didn’t go through. Please check your connection and try again.' });
      }
    });
  }

  async function main() {
    if (!/^[A-Za-z0-9_-]{16,64}$/.test(token)) return fail('This link is incomplete. Please use the full link you were sent.');
    let d: Delivery;
    try {
      const res = await api(undefined, `?t=${encodeURIComponent(token)}`);
      if (res.status === 404) return fail('This link is no longer active. Please contact Trutech Business for a new one.');
      if (!res.ok) throw new Error(String(res.status));
      d = await res.json();
    } catch {
      return fail('We couldn’t reach the server. Please check your connection and try again.');
    }
    set('client', d.client_name);
    set('title', d.title);
    set('status', STATUS[d.status] ?? '');
    set('date', date(d.created_at));
    set('message', d.message);
    document.title = `${d.title} · Trutech Business`;
    $('[data-files]').innerHTML = d.files.length
      ? d.files.map((f) => fileCard(f, d.allow_download)).join('')
      : '<p class="muted">Files will appear here soon.</p>';
    if (!d.allow_download) protect(d);
    history(d.reviews);
    setupForm(d);
    show('ready');
  }

  main();
  // A different link pasted into the same tab only changes the #part.
  addEventListener('hashchange', () => location.reload());
</script>

<style>
  .shell {
    min-height: 100svh;
    background: var(--bg);
  }
  .top {
    background: var(--navy-950);
    color: var(--mist-50);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 72px;
  }
  .bar a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  .secure {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--blue-200);
  }
  .state {
    padding-block: 120px;
    text-align: center;
  }
  .state .lead {
    margin: 0 auto 28px;
  }
  .delivery {
    padding-block: clamp(40px, 6vw, 80px);
  }
  .skel-files {
    margin-top: 40px;
  }
  .delivery h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
  }
  .badge {
    padding: 6px 14px;
    border-radius: 999px;
    background: rgb(74 127 167 / 0.14);
    color: var(--accent-strong);
    font-weight: 600;
    font-size: 0.85rem;
  }
  .message {
    white-space: pre-line;
    margin-bottom: 40px;
  }
  .h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-top: 8px;
  }
  .files {
    display: grid;
    gap: 18px;
    margin-bottom: 48px;
  }
  @media (min-width: 720px) {
    .files {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .files {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .files :global(.file) {
    display: grid;
    gap: 14px;
    padding: 14px;
    align-content: start;
  }
  .files :global(.preview) {
    display: grid;
    place-items: center;
    min-height: 180px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--surface-2);
  }
  .files :global(.preview img),
  .files :global(.preview video) {
    width: 100%;
    max-height: 420px;
    object-fit: contain;
  }
  .files :global(.preview.icon) {
    gap: 10px;
    padding: 16px;
    background: linear-gradient(160deg, var(--navy-950), var(--navy-800));
    color: var(--blue-200);
    font: 600 1.6rem var(--font-body);
  }
  .files :global(.preview audio) {
    width: 100%;
  }
  .files :global(.ext) {
    padding: 8px 14px;
    border: 1.5px solid currentColor;
    border-radius: 10px;
    font-size: 1rem;
    letter-spacing: 0.12em;
  }
  .files :global(.name) {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: 2px;
    overflow-wrap: anywhere;
  }
  .files :global(.info p) {
    font-size: 0.88rem;
    margin-bottom: 12px;
  }
  .files :global(.actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  /* View-only files */
  .protected .files {
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }
  .files :global(.guarded) {
    position: relative;
  }
  .files :global(.guarded canvas) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 520px;
    object-fit: contain;
    pointer-events: none;
  }
  .files :global(.wm) {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: var(--wm), var(--wm-dark);
    background-position:
      0 0,
      160px 90px;
  }
  .files :global(.guarded video) {
    position: relative;
  }
  .files :global(.pdf) {
    min-height: 180px;
    background: linear-gradient(160deg, var(--navy-950), var(--navy-800));
    color: var(--blue-200);
    font: 600 1.6rem var(--font-body);
  }
  .files :global(.pdf.expanded) {
    display: block;
    height: 560px;
  }
  .files :global(.pdf iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
  }
  .files :global(.note) {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }
  .shielded .files :global(.preview) {
    filter: blur(28px) saturate(0.4);
    transition: none;
  }
  @media print {
    .protected {
      display: none !important;
    }
  }
  .review {
    max-width: 720px;
    box-shadow: var(--shadow);
  }
  .review h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }
  form {
    display: grid;
    gap: 20px;
    margin-top: 8px;
  }
  .field {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    border: 0;
  }
  label,
  legend {
